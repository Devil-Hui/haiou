# 每天清理一次 aura 应用日志（Docker Compose 版）
[Unit]
Description=Daily aura application log pruning (Docker Compose)

[Timer]
# 04:30：与每日备份 03:30 错开，避免两个都扫盘的任务抢 IO。
# 也避开了整点（整点是各类系统定时任务与轮转的拥挤时刻）。
OnCalendar=*-*-* 04:30:00

# 机器当时关机，开机后补跑一次。清理是"幂等的幂等"——
# 漏一天不会造成错误，只是多留一天日志，所以补跑没有副作用。
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
