# ============================================================================
# 生产环境配置模板
#
# 用法：cp .env.prod.example .env.prod  然后填入真实值
# 启动：npm run start:prod
#       （等价于 node --env-file=.env.prod next start）
#
# 为什么不用 .env.production？
#   Next.js 只自动加载 .env.production.local / .env.local / .env.production / .env，
#   **不认 .env.prod**。用 start:prod 脚本显式指定，才能保证本地与生产各用一套。
#   .env 给本地开发（npm run dev），.env.prod 给生产（npm run start:prod）。
# ============================================================================

# ---- 数据库 ----
# compose 部署时这一行会被 compose 用 POSTGRES_* 重新拼出来覆盖。
# 格式：postgresql://用户名:密码@主机:5432/库名
# compose 里迁移与运行用同一个 POSTGRES_USER（默认 aura）
DATABASE_URL=

# compose 的 db 服务必填。缺失时 docker compose 直接拒绝启动（fail-closed）。
POSTGRES_DB=aura
POSTGRES_USER=aura
# 至少 16 位随机串。生成：openssl rand -hex 32
POSTGRES_PASSWORD=

# ---- 管理员 ----
# 生产必需。缺失时 /api/auth 的初始化接口返回 503。
# 至少 32 位随机串。生成：openssl rand -hex 32
ADMIN_SETUP_TOKEN=

# ---- Cloudflare 场景的关键设置 ----
# 必须是 0。原因是 Cloudflare 会在 X-Forwarded-For 末尾追加它自己的边缘节点 IP，
# 而应用在 hops>=1 时取的是最右那一段 —— 结果全站访客共用同一个限流键，
# 一个访客触发限流则所有人被限流。
#
# 设 0 后应用完全忽略 XFF，只读 X-Real-IP；而 Nginx 已把 X-Real-IP 写成
# Cloudflare 校验过的真实客户端 IP（见 deploy/docker/nginx/templates/conf.d/00-cloudflare-realip.conf.template 与 docs/Cloudflare部署.md）。
#
# 如果你不用 Cloudflare、直接 nginx 反代，这里应设为 1。
TRUSTED_PROXY_HOPS=0

# ---- 连接池与日志 ----
# 2C2G 机器建议 3~5。PG 常驻内存也需同步压小，见 docs/Cloudflare部署.md 第五节。
DB_POOL_MAX=3
AURA_LOG_LEVEL=info
# 日志目录。logrotate-aura.conf 只轮转 /var/log/aura/*，不设这项日志会落在
# 项目目录的 logs/ 下且不被接管，会无限增长。
AURA_LOG_DIR=/var/log/aura

# ---- 后台准入 ----
# 生产建议显式设为 true。关闭时 /api/* 与 /admin/* 全部返回 404。
ADMIN_ACCESS=true

# ---- 支付通道（按需启用，未配置留空）----
# 支付宝应用私钥（PKCS8）。留空则支付宝通道无法开启。
ALIPAY_PRIVATE_KEY=
# 易支付商户密钥（MD5）。
EPAY_KEY=
# 链上监听器 HMAC 密钥，至少 32 字符。留空则 USDT 回调返回 501，只能人工确认到账。
USDT_WEBHOOK_SECRET=

# ---- 业务密钥 ----
# 账号凭证加密口令。缺失时自动充值**拒绝提交**并提示联系客服。
# 任意长度口令。生成：openssl rand -hex 32
CREDENTIAL_KEY=
# HTTP 上游签名密钥。走 aisub 适配器时不需要。
# 任意随机串。生成：openssl rand -hex 32
UPSTREAM_SECRET=
