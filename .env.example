# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，且不会被打进镜像；请只填在部署机器上。
# 本文件里所有路径都相对仓库根目录，不含任何盘符或绝对路径。

# ---- PostgreSQL（Docker 与非 Docker 部署都需要这些来创建库）----
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=请改成强密码

# ---- 应用连接串 ----
# Docker 部署时，compose 会用上面的 POSTGRES_* 重新拼一个覆盖这里的值，
# 所以这一行只在「非 Docker 部署」和「本地跑 drizzle-kit push」时生效。
DATABASE_URL=postgresql://aura:请改成强密码@127.0.0.1:5432/aura

# ---- 必填：管理员初始化令牌 ----
# 生产环境（NODE_ENV=production）未设置时，初始化接口会直接返回 503。
ADMIN_SETUP_TOKEN=请改成32位以上随机串

# ---- 支付通道：只填这里，重启即生效，不必再去后台点开关 ----
#
# 【规则】环境变量优先于数据库。只要下面这些填齐，通道自动启用；
# 留空则回落到后台「支付配置」页里填的值（老部署无需改动）。
# 需要临时关掉某条通道时，用 ALIPAY_ENABLED=false / EPAY_ENABLED=false 显式关闭。
# 申请步骤与「点哪里、粘到哪」见 docs/所需密钥.md。
#
# 密钥类变量一律不要写进数据库、也不会下发浏览器。

# ---- 支付宝（需要已备案的公网 HTTPS 域名）----
# 站点公网地址，结尾不要斜杠。支付宝与易支付都用它拼回调地址。
SITE_URL=
# 应用私钥（PKCS8）。整段用双引号包起来，因为私钥里有换行
ALIPAY_PRIVATE_KEY=
# 应用 AppID：16 位数字，形如 2021xxxxxxxxxxxx
ALIPAY_APP_ID=
# 卖家 PID：12~24 位数字，2088 开头
ALIPAY_SELLER_ID=
# 支付宝公钥（MIIBIjANBgkq... 开头）。注意不是你的应用私钥
ALIPAY_PUBLIC_KEY=
# 通道费率（%）。可留空，默认 0.60
ALIPAY_FEE_RATE=

# ---- 易支付 / 聚合收银台（最快上线，无需域名）----
# MD5 签名密钥
EPAY_KEY=
# 商户 PID（纯数字）
EPAY_PID=
# 收银台网关地址，例如 https://pay.example.com
EPAY_URL=
# 通道费率（%）。按你与平台签约的费率填，不确定先留 0
EPAY_FEE_RATE=

# ---- BEpusdt 自建 USDT 收银台（推荐：免企业资质，钱直接进你的钱包）----
# 实际项目是 v03413/BEpusdt（与原始 epusdt 已完全独立，API 不兼容）。
# 部署与申请步骤见 docs/BEpusdt自建USDT收银台.md。
# 鉴权只有一个 API Token，在你自己部署的 BEpusdt 后台生成，不花钱、不需要企业资质。
EPUSDT_URL=
EPUSDT_TOKEN=
# 收的币种与链，BEpusdt 用一个字段合写。默认 usdt.trc20（与本站 USDT 直充同一条链）
EPUSDT_TRADE_TYPE=usdt.trc20
# 平台层不抽成，默认 0。真实成本是 TRC20 链上费，需要覆盖就按
# 「链上费(元) ÷ 套餐价 × 100」折算，与 USDT_FEE_RATE 同一套算法
EPUSDT_FEE_RATE=0

# ---- 币安支付 Binance Pay（需企业主体 KYB，无沙箱）----
# 商户平台 API Key（对应请求头 BinancePay-Certificate-SN）
BINANCE_PAY_API_KEY=
# 商户平台 API Secret。丢失只能重置，无法找回
BINANCE_PAY_SECRET=
# 商户号
BINANCE_PAY_MERCHANT_ID=
# 可选：把币安公钥固定下来，避免每笔通知都去调证书接口
# 留空则自动通过 /binancepay/openapi/certificates 拉取并缓存 7 小时
BINANCE_PAY_PUBLIC_KEY=
# 通道费率（%）。币安侧通常 0
BINANCE_PAY_FEE_RATE=

# ---- USDT-TRC20 直充 ----
# TRC20 收款钱包地址（T 开头 34 位）
USDT_WALLET_ADDRESS=
# 1 USDT = ? CNY，默认 7.20
USDT_EXCHANGE_RATE=
# 通道费率（%）。TRC20 链上费是固定的约 1 USDT，不按比例收
USDT_FEE_RATE=
# 链上监听回调的 HMAC 密钥，至少 32 位。不配置则只能人工确认到账
USDT_WEBHOOK_SECRET=
# 自动充值：上游卡密系统的签名密钥
UPSTREAM_SECRET=
# 自动充值：账号凭证的加密密钥（AES-256-GCM）。
# 未配置时自动充值会拒绝提交并提示联系客服——宁可不可用，也不明文落库。
# 生成：openssl rand -hex 32
CREDENTIAL_KEY=

# ---- 可选：小机器调优 ----
# 应用前面的可信代理层数（0-5，默认 1）。
#
# ⚠️ 接入 Cloudflare 后**必须设为 0**：
# CF 会在 X-Forwarded-For 末尾追加它自己的边缘节点 IP，hops>=1 时应用取到的
# 就是那个节点 IP → **全站访客共用一个限流桶**（一个访客触发限流，所有人一起被限）。
# 设 0 后应用只读 X-Real-IP，而 Nginx 已把该头写成 CF 校验过的真实客户端 IP
# （deploy/docker/nginx/templates/conf.d/00-cloudflare-realip.conf）。
#
# 直连裸机 Nginx（不经 Cloudflare）时才用 1。
TRUSTED_PROXY_HOPS=0
# 数据库连接池上限（1-50，默认 10）。2 核 2 GB 建议 5。
DB_POOL_MAX=5

# ---- 管理后台访问闸门 ----
# 生产环境默认关闭后台：未设置为 true 时 /admin 与 /admin-login 一律返回 404。
ADMIN_ACCESS=false

# ---- 日志 ----
# 级别：debug / info / warn / error。审计日志（category=audit）固定按 info 输出，
# 不受此项影响。生产建议保持 info——debug 会显著增加日志量并拖慢 2C2G 的磁盘 IO。
AURA_LOG_LEVEL=info

# ============================================================================
# Nginx 边缘层（仅当使用 deploy/docker-compose.nginx.yml 时需要）
#
# 职责划分：
#   前端（页面 / 静态资源 / 浏览器缓存）→ Cloudflare 边缘
#   后端（Next.js 应用 / PostgreSQL）      → 源站（本compose）
#   Nginx 位于 CF 与应用之间，负责真实 IP 还原、限流、静态直出、gzip/brotli。
# ============================================================================

# ---- 域名（必填）----
# 站点的唯一对外域名。Nginx 的 server_name、证书匹配、301 跳转都用它。
# 必须是已备案、已完成 ICP 备案与 Cloudflare 接入的域名。
AURA_DOMAIN=aura.example.com

# ---- TLS 证书 ----
# 【推荐】Cloudflare Origin CA：15 年有效期、免签发、256/384 位可选。
#   获取：Cloudflare 控制台 → SSL/TLS → 源服务器 → 创建证书
#   把生成的 cert/key 存到./data/nginx/certs/{aura.crt,aura.key}
#
# 【备选】Let's Encrypt：浏览器直连也信任，但需挂载证书目录 + 定期续期。
#   NGINX_SSL_CERT=/etc/nginx/certs/live/aura.example.com/fullchain.pem
#   NGINX_SSL_KEY=/etc/nginx/certs/live/aura.example.com/privkey.pem
#   NGINX_SSL_TRUSTED_CERT=/etc/nginx/certs/live/aura.example.com/chain.pem  ← OCSP 必需
#
# 注意：Origin CA 只被 Cloudflare 信任，直连域名会提示证书错误。
# 这只影响你自己调试，用户访问（经 CF）完全正常。
NGINX_SSL_CERT=/etc/nginx/certs/aura.crt
NGINX_SSL_KEY=/etc/nginx/certs/aura.key
# OCSP stapling 用的信任链证书。用 Origin CA 时必须留空（该 CA 无公共 OCSP responder，
# 填了会导致握手失败）。
NGINX_SSL_TRUSTED_CERT=

# ---- 端口映射（宿主机侧）----
# 均只绑 127.0.0.1。改成 "80:80" 等于把源站直接暴露公网、绕过防火墙，
# 只有确定不走 Cloudflare 时才改。
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# 容器健康检查端口，通常无需改动
NGINX_HEALTH_PORT=9443

# ---- 请求体上限 ----
# 本站无文件上传（接口本身限制 4~16 KB），256k 足够且能挡掉恶意大包。
NGINX_MAX_BODY_SIZE=256k

# ---- Cloudflare 回源防护（进阶）----
# Cloudflare 回源可指向独立端口（必须是 CF 支持的 HTTPS 回源端口：
# 443 / 2053 / 2083 / 2087 / 2096 / 8443）。设为与 443 相同的值即不启用。
# 启用后可把 443 从安全组关掉，让攻击者无法探测到真实服务。
NGINX_CF_GUARD_PORT=8443

# ---- 资源与句柄上限（2C2G 基线）----
# 升级机器后跑 bash deploy/nginx-retune.sh 会按新规格自动重算并写入这里，
# 不必手工调整。
NGINX_MEM_LIMIT=128M
NGINX_MEM_RESERVE=32M
NGINX_NOFILE_SOFT=16384
NGINX_NOFILE_HARD=16384

# ---- 镜像版本策略 ----
# 构建用的 Alpine 基础镜像。国内走 daocloud 加速（已配好默认值）；
# 若服务器能直连 Docker Hub，可改成 alpine:3.22。
NGINX_ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:3.22

# ============================================================================
# Cloudflare 控制台侧设置（这些不在 .env，只列在此处备忘）
#
# 生效前提：本项目的真实 IP 还原依赖 CF-Connecting-IP 头，
# 该头**只有请求经 Cloudflare 代理时才会出现**。
# 若把 DNS 改成"仅 DNS"（灰云），realip 不生效，日志与限流会看到真实对端 IP
# （本身可用），但 x-real-ip 仍正常，无需改其他配置。
#
# 必须确认的项：
#  1. 加密模式 = 完全（严格）。不要用 Flexible（回源明文，且易被中间人改头）。
#  2. 始终使用 HTTPS = 开。
#  3. HTTP/2、WebSocket、Brotli = 开。
#  4. 缓存等级 = 遵循源站（**不要**"缓存全部"，否则 /api/* 会被缓存）。
#  5. 最低 TLS = 1.2。
#  6. IPv6 = 开（本站已在 Nginx 侧放行 CF 的 IPv6 段）。
#  7. 0-RTT = 关（本项目无需，且开启会削弱早期数据保护）。
#  8. 安全组/ufw 只放通 Cloudflare 官方 IP 段到 80/443。
# ============================================================================

# 时区（影响容器内日志时间）
TZ=Asia/Shanghai
