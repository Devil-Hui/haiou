# ============================================================================
# 行尾符规范（对 Linux 部署是功能性要求，不是风格偏好）
#
# 背景：本项目在 Windows（CRLF）上开发。部署目标是 Linux。
# CRLF 到了Linux 上不是"格式不统一"这种 cosmetic 问题，而是真故障：
#   · 带 \r 的 shebang → 内核按字面文件名找 "/entrypoint-haiou.sh\r"，
#     直接 exec 失败（实测 exit 255 / no such file or directory），容器起不来
#   · systemd unit 文件带 \r → "Failed to parse" 或忽略该unit
#   · Nginx 配置带 \r → nginx -t 可能侥幸通过，但正则与日志被污染（隐性故障）
#
# 策略：仓库内一律存 LF（text=auto eol=lf），Windows 编辑器/svn 也不改写它。
# ============================================================================

# 默认：所有文本文件在仓库内与工作区均为 LF
* text=auto eol=lf

# ── 明确必须 LF 的类型 ──────────────────────────────────────────────────────
*.sh          text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.conf        text eol=lf
*.template    text eol=lf
*.mjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.css         text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.sh          text eol=lf

# Dockerfile 没有内建属性名，用通配覆盖
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# ── 必须保持原样（二进制，禁止行尾转换）────────────────────────────────────
*.jpg         binary
*.jpeg        binary
*.png         binary
*.gif         binary
*.ico         binary
*.webp        binary
*.pdf         binary
*.zip         binary
*.gz          binary
*.dump        binary
*.dump.*      binary
*.tar         binary